# Copy this file to a local .env or export these variables in your shell.
# Do not commit real .env files.

# Use a directory outside the repository. Replace this with a writable path on each machine.
PPGL_DATA_ROOT=/var/lib/ppgl-assist

# Brain glioma MRI segmentation. Model files stay outside the Git repository.
PPGL_GLIOMA_ENABLED=false
PPGL_GLIOMA_CASES_DIR=brain-cases
PPGL_GLIOMA_MODEL_DIR=models/brain-glioma/nnUNetTrainer__nnUNetPlans__3d_fullres
PPGL_GLIOMA_DEVICE=cuda
PPGL_GLIOMA_MAX_UPLOAD_MB=2048
PPGL_GLIOMA_TIMEOUT_SECONDS=7200

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ppgl_analyze
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_TIMEZONE=Asia/Shanghai
MYSQL_USE_SSL=false

PPGL_AUTH_JWT_SECRET=change-this-to-a-random-string-at-least-32-bytes
PPGL_AUTH_JWT_TTL_MINUTES=120
PPGL_INTERNAL_API_KEY=change-this-in-local-env

# These are optional. When omitted, FastAPI derives them from PPGL_DATA_ROOT.
# PPGL_CASES_DIR=/var/lib/ppgl-assist/cases
# PPGL_RAG_DOCUMENTS_DIR=/var/lib/ppgl-assist/rag-documents
# PPGL_RAG_CHUNKS_PATH=/var/lib/ppgl-assist/rag-parsed/chunks.jsonl
# PPGL_QDRANT_PATH=/var/lib/ppgl-assist/rag-index/qdrant

# Service addresses. On one machine keep 127.0.0.1; in production use the service DNS name or private IP.
PPGL_PIPELINE_BASE_URL=http://127.0.0.1:8000
PPGL_LLM_CHAT_URL=http://127.0.0.1:8000/api/llm/chat/stream
PPGL_JETSON_BASE_URL=http://127.0.0.1:8001
PPGL_CORS_ORIGINS=https://ppgl.example.com
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

CHAT_LLM_PROVIDER=openai_compat
CHAT_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
CHAT_OPENAI_MODEL=ppgl-qwen3-32b-q4:latest
CHAT_OPENAI_API_KEY=ollama

# Model and predictor paths must exist and be readable by the service account on the deployment host.
JETSON_JOB_ROOT=/var/lib/ppgl-assist/jobs
TOTALSEG_WEIGHTS_PATH=/opt/ppgl-models/TotalSegmentator

REPORT_LLM_PROVIDER=openai_compat
REPORT_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
REPORT_OPENAI_MODEL=ppgl-qwen3-32b-q4:latest
REPORT_OPENAI_API_KEY=ollama
