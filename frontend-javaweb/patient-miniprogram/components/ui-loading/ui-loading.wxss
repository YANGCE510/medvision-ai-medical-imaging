.ui-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 40rpx 28rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
}

.ui-loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 999rpx;
  animation: ui-spin 760ms linear infinite;
}

@keyframes ui-spin {
  to {
    transform: rotate(360deg);
  }
}
