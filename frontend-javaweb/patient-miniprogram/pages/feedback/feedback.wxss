.feedback-page {
  padding-bottom: 40rpx;
}

.feedback-card {
  padding: 30rpx;
}

.feedback-title,
.feedback-copy {
  display: block;
}

.feedback-title {
  color: #172331;
  font-size: 36rpx;
  font-weight: 850;
}

.feedback-copy {
  margin-top: 12rpx;
  color: #66758a;
  font-size: 26rpx;
  line-height: 1.6;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 28rpx;
}

.field > text {
  color: #526174;
  font-size: 26rpx;
  font-weight: 800;
}

.field textarea {
  min-height: 260rpx;
  padding: 22rpx;
  border: 1rpx solid #dbe4ef;
  border-radius: 18rpx;
  color: #172331;
  background: #f8fafc;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.primary-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 86rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #2563eb;
  font-size: 29rpx;
  font-weight: 850;
}
