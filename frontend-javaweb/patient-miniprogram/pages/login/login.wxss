.login-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
}

.login-hero {
  margin-bottom: 34rpx;
}

.login-card {
  padding: 30rpx;
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #eef3f8;
}

.auth-tabs button {
  width: 100%;
  height: 68rpx;
  border-radius: 999rpx;
  color: #66758a;
  font-size: 28rpx;
  font-weight: 800;
}

.auth-tabs button.active {
  color: #172331;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(23, 35, 49, 0.08);
}

.form-block {
  margin-top: 28rpx;
}

.field {
  display: block;
  margin-top: 22rpx;
}

.field text {
  display: block;
  color: #526174;
  font-size: 25rpx;
  font-weight: 750;
}

.field input {
  height: 88rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe4ef;
  border-radius: 22rpx;
  color: #172331;
  background: #f8fafc;
  font-size: 29rpx;
}

.submit-btn {
  width: 56%;
  min-width: 320rpx;
  max-width: 420rpx;
  height: 84rpx;
  margin: 34rpx auto 0;
}
