<view class="page-shell reports-page">
  <view class="hero">
    <view>
      <text class="page-title">我的报告</text>
    </view>
    <button class="logout-btn" bindtap="logout">退出</button>
  </view>

  <view wx:if="{{loading}}" class="card loading-card">正在加载报告...</view>

  <view wx:elif="{{reports.length}}" class="report-list">
    <view
      wx:for="{{reports}}"
      wx:key="taskId"
      class="card report-card"
      bindtap="openReport"
      data-id="{{item.taskId}}"
    >
      <view class="report-card-head">
        <view>
          <text class="report-title">影像分析报告</text>
          <text class="report-date">{{item.createdAt}}</text>
        </view>
      </view>
      <text class="report-summary">{{item.overview}}</text>
      <view class="report-meta">
        <text class="review-status-pill">{{item.statusText}}</text>
        <text>{{item.measurements[1].value}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="card empty-card">
    <text class="empty-title">暂无报告</text>
    <text class="empty-copy">医生生成报告后，你可以在这里查看。</text>
  </view>
</view>
